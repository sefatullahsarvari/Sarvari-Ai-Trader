# XM_BRIDGE_TOKEN: Secret shared bearer token used ONLY on the server/Cloudflare Worker
# to authenticate incoming POST /api/bridge/mt5 requests from SA_AI_TRADER_BRIDGE.mq5.
# NEVER expose this token in frontend code or prefix it with VITE_.
XM_BRIDGE_TOKEN=

# Optional: Frontend API base URL if Cloudflare Pages frontend calls a separate Worker domain.
# Leave empty when Pages Functions or same-origin Express proxy handles /api/* routes.
VITE_API_BASE_URL=

# Optional: Local server port (defaults to 3000)
PORT=3000
